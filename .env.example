# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Vroom Vroom"
SECRET_KEY=vroom-insecure-development-secret-key-change-in-production-min-32-chars

# Database Configuration (PostgreSQL 17)
# Replace 'postgres:your_password' with your local PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vroomvroom
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/vroomvroom
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/vroomvroom

# CORS & Frontend URL
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Auth & Session Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Platform Configurable Defaults
DEFAULT_CITY_CODE=BLR
HOLD_EXPIRATION_MINUTES=15
DEFAULT_COMMISSION_PERCENT=20
FREE_CANCELLATION_HOURS=24
